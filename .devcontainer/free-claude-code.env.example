# free-claude-code configuration
# Docs: https://github.com/Alishahryar1/free-claude-code
#
# DEEPSEEK_API_KEY is intentionally left empty here.
# It is merged in from .env.local (gitignored) on container build.

# DeepSeek Config (uses native Anthropic Messages at api.deepseek.com/anthropic)
DEEPSEEK_API_KEY=""

# Model routing
MODEL_OPUS="deepseek/deepseek-v4-pro"
MODEL_SONNET="deepseek/deepseek-v4-pro"
MODEL_HAIKU="deepseek/deepseek-v4-flash"
MODEL="deepseek/deepseek-v4-flash"

# Thinking output
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# Provider config
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5

# HTTP client timeouts (seconds)
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=10

# Proxy auth token — must match ANTHROPIC_AUTH_TOKEN in the ds alias
ANTHROPIC_AUTH_TOKEN="freecc"

# Messaging — not used
MESSAGING_PLATFORM="none"

# Local web tools
ENABLE_WEB_SERVER_TOOLS=true
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false

# Diagnostics — keep off in normal use
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false