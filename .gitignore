# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
*.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — whitelist only what's useful
.claude/*
!.claude/CLAUDE.md
!.claude/commands/
!.claude/commands/**
.claude.json

# free-claude-code — config contains secrets, runtime files for local debugging only
.config/free-claude-code/.env
free-claude-code-proxy.log
free-claude-code-proxy.pid